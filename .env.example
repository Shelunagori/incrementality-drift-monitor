# --- Database ---
DATABASE_URL=postgresql+psycopg://idm:idm@localhost:5432/idm
TEST_DATABASE_URL=postgresql+psycopg://idm:idm@localhost:5432/idm_test

# --- LLM (chat) provider: ollama | anthropic | gemini | openai ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Embedding provider: ollama | anthropic | gemini | openai ---
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
