# --- Database ---
DATABASE_URL=postgresql+psycopg://idm:idm@localhost:5432/idm
TEST_DATABASE_URL=postgresql+psycopg://idm:idm@localhost:5432/idm_test
# postgres:// and postgresql:// URLs (Supabase, Railway) are accepted and switched to psycopg.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2

# --- API server ---
PORT=8000
# Comma-separated list of allowed browser origins (your Vercel URL in production).
CORS_ORIGINS=http://localhost:3000
# Enables POST /demo/reset (header X-Demo-Token). Empty = endpoint disabled.
DEMO_RESET_TOKEN=
# Per-IP limit on /agent/* (protects the LLM quota on a public demo).
AGENT_RATE_LIMIT_PER_MIN=10

# --- LLM (chat) provider: ollama | anthropic | gemini | openai | cloudflare | fake (offline) ---
LLM_PROVIDER=ollama
# Optional ordered chain, e.g. "gemini,cloudflare": transient errors (429/503/timeout/connection)
# are retried twice (1s, 3s backoff), then the next provider is tried. Empty = LLM_PROVIDER only.
LLM_FALLBACK_PROVIDERS=
LLM_TIMEOUT_SECONDS=20
# Explicit output limit for every chat provider (Cloudflare's default truncates answers).
LLM_MAX_TOKENS=1024
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Gemini key: GEMINI_API_KEY (GOOGLE_API_KEY also accepted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Cloudflare Workers AI (chat only; OpenAI-compatible endpoint)
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# --- Embedding provider: ollama | anthropic | gemini | openai | fake ---
# anthropic = Voyage AI (Anthropic has no embeddings API; Voyage is its recommended partner)
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
